<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pokestore_figure_view_list" model="ir.ui.view">
        <field name="name">pokestore.figure.list</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <list string="Figuras">
                <field name="name"/>
                <field name="pokemon"/>
                <field name="collection_id"/>
                <field name="rarity"/>
                <field name="price"/>
                <field name="stock"/>
                <field name="stock_value"/>
            </list>
        </field>
    </record>
    <record id="pokestore_figure_view_form" model="ir.ui.view">
        <field name="name">pokestore.figure.form</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <form string="Figura">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="pokemon"/>
                            <field name="collection_id"/>
                        </group>
                        <group>
                            <field name="rarity"/>
                            <field name="price"/>
                            <field name="stock"/>
                            <field name="stock_value"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tags de la figura">
                            <field name="tag_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
        <!-- NUEVA VISTA DE BÚSQUEDA -->
    <record id="pokestore_figure_view_search" model="ir.ui.view">
        <field name="name">pokestore.figure.search</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <search string="Buscar Figuras">
                <!-- 1. Buscar por nombre y Pokémon -->
                <field name="name"/>
                <field name="pokemon"/>
                <field name="collection_id"/>

                <!-- 2. Filtro para figuras exclusivas -->
                <filter name="exclusive_figures" string="Exclusivas" domain="[('rarity', '=', 'exclusive')]"/>

                <!-- 3. Agrupar por colección -->
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_collection" string="Colección" context="{'group_by': 'collection_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="pokestore_figure_action" model="ir.actions.act_window">
        <field name="name">Figuras</field>
        <field name="res_model">pokestore.figure</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>