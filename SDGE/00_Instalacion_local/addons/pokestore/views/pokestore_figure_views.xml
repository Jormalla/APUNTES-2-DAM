<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pokestore_figure_view_list" model="ir.ui.view">
        <field name="name">pokestore.figure.list</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <list string="Figuras">
                <field name="name"/>
                <field name="pokemon"/>
                <field name="collection_id"/>
                <field name="rarity"/>
                <field name="price"/>
                <field name="stock"/>
                <field name="stock_value"/>
            </list>
        </field>
    </record>
    <record id="pokestore_figure_view_form" model="ir.ui.view">
        <field name="name">pokestore.figure.form</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <form string="Figura">
                <sheet>
                    <group>
                        <group>
                            <button name="action_agotar_stock" type="object" string="Agotar stock" class="btn-primary"/>
                            <field name="name"/>
                            <field name="pokemon"/>
                            <field name="collection_id"/>
                             <field name="tag_ids" widget="many2many_tags" />
                        </group>
                        <group>
                            <field name="rarity"/>
                            <field name="price"/>
                            <field name="stock"/>
                            <field name="stock_value" readonly="1"/> <!--readonly 1 hace que no se pueda editar desde odoo-->
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas internas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
        <!-- NUEVA VISTA DE BÚSQUEDA -->
    <record id="pokestore_figure_view_search" model="ir.ui.view">
        <field name="name">pokestore.figure.search</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <search string="Buscar Figuras">
                <!-- 1. Buscar por nombre y Pokémon -->
                <field name="name"/>
                <field name="pokemon"/>
                <field name="collection_id"/>

                <!-- 2. Filtro para figuras exclusivas -->
                <filter name="exclusive_figures" string="Exclusivas" domain="[('rarity', '=', 'exclusive')]"/>

                <!-- 3. Agrupar por colección -->
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_collection" string="Colección" context="{'group_by': 'collection_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- Agotar el stock de todos las figuras -->
    <record id="pokestore_action_agotar_stock" model="ir.actions.server">
        <field name="name">🗑️ Agotar stock</field>
        <field name="model_id" ref="model_pokestore_figure"/>
        <field name="binding_model_id" ref="model_pokestore_figure"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            records.action_agotar_stock()
        </field>

    </record>
    <record id="pokestore_figure_action" model="ir.actions.act_window">
        <field name="name">Figuras</field>
        <field name="res_model">pokestore.figure</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>