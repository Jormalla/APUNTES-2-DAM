<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pokestore_saler_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.pokestore</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Empaquetado figuras Pokémon" name="empaquetado">
                    <group string="PokeStore">
                        <field name="embalaje_coleccionista" />
                        <field name="instrucciones_empaquetado" />
                        <field name="prioridad_preparacion" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>