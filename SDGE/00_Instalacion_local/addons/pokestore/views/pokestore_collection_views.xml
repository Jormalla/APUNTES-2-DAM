<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pokestore_collection_view_list" model="ir.ui.view">
        <field name="name">pokestore.collection.list</field>
        <field name="model">pokestore.collection</field>
        <field name="arch" type="xml">
            <list string="Colecciones">
                <field name="name" />
                <field name="generacion" />
                <field name="fecha_lanzamiento" />
            </list>
        </field>
    </record>
    <record id="pokestore_collection_view_form" model="ir.ui.view">
        <field name="name">pokestore.collection.form</field>
        <field name="model">pokestore.collection</field>
        <field name="arch" type="xml">
            <form string="Colección">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="generacion" />
                        <field name="fecha_lanzamiento" />
                    </group>
                    <notebook>
                        <page string="Figuras de la colección">
                            <field name="figure_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="pokemon" />
                                    <field name="rarity" />
                                    <field name="price" />
                                    <field name="stock" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pokestore_collection_action" model="ir.actions.act_window">
        <field name="name">Colecciones</field>
        <field name="res_model">pokestore.collection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>