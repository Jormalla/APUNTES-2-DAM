<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Figura 1: Normal -->
        <record id="figure_pikachu_basic" model="pokestore.figure">
            <field name="name">Pikachu Edición Estándar</field>
            <field name="pokemon">Pikachu</field>
            <field name="rarity">normal</field>
            <field name="price">19.99</field>
            <field name="stock">50</field>
            <field name="collection_id" ref="pokestore.collection_kanto"/>
            <field name="notes">Figura ideal para exhibición en mostrador.</field>
        </record>

        <!-- Figura 2: Rara -->
        <record id="figure_charizard_holo" model="pokestore.figure">
            <field name="name">Charizard Llamarada Dinámica</field>
            <field name="pokemon">Charizard</field>
            <field name="rarity">rare</field>
            <field name="price">49.95</field>
            <field name="stock">12</field>
            <field name="collection_id" ref="pokestore.collection_kanto"/>
            <field name="notes">Incluye base translúcida con efecto de fuego.</field>
        </record>

        <!-- Figura 3: Exclusiva (Obligatorio incluir collection_id por @api.constrains) -->
        <record id="figure_mewtwo_exclusive" model="pokestore.figure">
            <field name="name">Mewtwo Edición Coleccionista Numerada</field>
            <field name="pokemon">Mewtwo</field>
            <field name="rarity">exclusive</field>
            <field name="price">129.90</field>
            <field name="stock">3</field>
            <field name="collection_id" ref="pokestore.collection_legendarios_kanto"/>
            <field name="notes">Revisar embalaje especial. Certificado de autenticidad incluido.</field>
        </record>
    </data>
</odoo>